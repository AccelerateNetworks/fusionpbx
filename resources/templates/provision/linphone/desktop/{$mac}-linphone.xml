  <section name="proxy_default_values">
    <entry name="avpf" overwrite="true">0</entry>
  </section>
{$id=0}
{foreach $account as $a}
  <section name="auth_info_{$id}">
    <entry name="username" overwrite="true">{$a.user_id}</entry>
    <entry name="passwd" >{$a.password}</entry>
    <entry name="realm" overwrite="true">{$a.server_address}</entry>
    <entry name="domain" overwrite="true">{$a.server_address}</entry>
    <entry name="algorithm" overwrite="true">MD5</entry>
  </section>
  <section name="proxy_{$id++}">
    <entry name="reg_proxy" overwrite="true">&lt;sip:{$a.server_address};transport={if $a.sip_transport == 'udp'}udp{/if}{if $a.sip_transport == 'tcp'}tcp{/if}{if $a.sip_transport == 'tls'}tls{/if}&gt;</entry>
    <entry name="reg_identity" overwrite="true">"{$a.display_name}" &lt;sip:{$a.user_id}@{$a.server_address}&gt;</entry>
    <entry name="reg_route" overwrite="true">&lt;sip:{$a.server_address};transport={if $a.sip_transport == 'udp'}udp{/if}{if $a.sip_transport == 'tcp'}tcp{/if}{if $a.sip_transport == 'tls'}tls{/if}&gt;</entry>
    <entry name="realm" overwrite="true">{$a.server_address}</entry>
    <entry name="reg_expires" overwrite="true">3600</entry>
    <entry name="reg_sendregister" overwrite="true">{if $a.enabled == 'true'}1{else}0{/if}</entry>
    <entry name="publish" overwrite="true">1</entry>
    <entry name="dial_escape_plus" overwrite="true">0</entry>
  </section>
{/foreach}  
{$id=0}
{foreach $contacts as $contact}{foreach $contact.numbers as $number}
  <section name="friend_{$id++}">
    <entry name="url">"{$contact.contact_name_given} {$row.contact_name_family} ({$number.phone_label})" sip:{$number.phone_number}@{$a.server_address}.sip.callpipe.com</entry>
    <entry name="pol">accept</entry>
    <entry name="subscribe">{if $number.phone_number|count_characters >= 10}0{else}1{/if}</entry>
  </section>
{/foreach}{/foreach}
</config>
